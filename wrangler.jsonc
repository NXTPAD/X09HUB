{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "x09-hub",
  "compatibility_date": "2025-09-01",
  // Static site: everything in ./public is served as-is. No server code needed.
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // Serves the hub at x09hub.com. The domain must be a zone on your Cloudflare account.
  // Delete this "routes" block if you only want the free *.workers.dev address for now.
  "routes": [
    { "pattern": "x09hub.com", "custom_domain": true },
    { "pattern": "www.x09hub.com", "custom_domain": true }
  ]
}
